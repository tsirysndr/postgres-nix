# Copy OUTSIDE the repository and chmod 600; never store real URLs in Nix.
# URL-encode passwords; replace placeholders with dedicated replication credentials.
PGSTREAM_POSTGRES_LISTENER_URL="postgres://pgstream_source:REPLACE@127.0.0.1:5432/app?sslmode=disable"
PGSTREAM_POSTGRES_SNAPSHOT_STORE_URL="postgres://pgstream_source:REPLACE@127.0.0.1:5432/app?sslmode=disable"
PGSTREAM_POSTGRES_WRITER_TARGET_URL="postgres://pgstream_target:REPLACE@127.0.0.1:5433/app?sslmode=disable"
PGSTREAM_POSTGRES_SNAPSHOT_TABLES="public.*"
